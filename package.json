    "configuration": {
      "title": "Sakura Atelier",
      "properties": {
        "sakuraRunner.defaultMode": {
          "type": "string",
          "enum": [
            "auto",
            "file",
            "project"
          ],
          "enumDescriptions": [
            "%enum.sakuraRunner.defaultMode.0%",
            "%enum.sakuraRunner.defaultMode.1%",
            "%enum.sakuraRunner.defaultMode.2%"
          ],
          "default": "auto",
          "description": "%setting.sakuraRunner.defaultMode%"
        },
        "sakuraRunner.script": {
          "type": "string",
          "default": "",
          "description": "%setting.sakuraRunner.script%"
        },
        "sakuraRunner.projectTask": {
          "type": "string",
          "default": "",
          "description": "%setting.sakuraRunner.projectTask%"
        },
        "sakuraRunner.pythonPath": {
          "type": "string",
          "default": "",
          "description": "%setting.sakuraRunner.pythonPath%"
        },
        "sakuraRunner.cCompiler": {
          "type": "string",
          "default": "",
          "description": "%setting.sakuraRunner.cCompiler%"
        },
        "sakuraRunner.cppCompiler": {
          "type": "string",
          "default": "",
          "description": "%setting.sakuraRunner.cppCompiler%"
        },
        "sakuraRunner.configurations": {
          "type": "array",
          "default": [],
          "description": "%setting.sakuraRunner.configurations%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "language",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string",
                "enum": [
                  "go",
                  "python",
                  "rust",
                  "c",
                  "cpp",
                  "csharp",
                  "java",
                  "javascript",
                  "javascriptreact",
                  "typescript",
                  "typescriptreact"
                ]
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            }
          }
        },
        "sakuraRunner.javaPath": {
          "type": "string",
          "default": "",
          "description": "%setting.sakuraRunner.javaPath%"
        },
        "sakuraRunner.python.autoActivateTerminal": {
          "type": "boolean",
          "default": true,
          "description": "%setting.sakuraRunner.python.autoActivateTerminal%"
        },
        "sakuraAtelier.python.autoActivateTerminal": {
          "type": "boolean",
          "default": true,
          "description": "%setting.sakuraAtelier.python.autoActivateTerminal%"
        },
        "sakuraAtelier.language": {
          "type": "string",
          "enum": [
            "zh-cn",
            "auto",
            "en"
          ],
          "default": "zh-cn",
          "enumDescriptions": [
            "%enum.sakuraAtelier.language.0%",
            "%enum.sakuraAtelier.language.1%",
            "%enum.sakuraAtelier.language.2%"
          ],
          "description": "%setting.sakuraAtelier.language%"
        },
        "sakuraAtelier.stm32.autoIntelliSense": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%setting.sakuraAtelier.stm32.autoIntelliSense%"
        },
        "sakuraAtelier.platformio.autoIntelliSense": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "%setting.sakuraAtelier.platformio.autoIntelliSense%"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "/.vscode/sakura-atelier.json"
        ],
        "url": "./configuration.schema.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "sakuraRunner",
        "required": [
          "sakuraId"
        ],
        "properties": {
          "sakuraId": {
            "type": "string",
            "description": "%task.sakuraId%"
          }
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "sakuraAtelier.iocViewer",
        "displayName": "Sakura Atelier STM32CubeMX Project",
        "selector": [
          {
            "filenamePattern": "*.ioc"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "compile": "node scripts/clean-output.cjs && tsc -p . && node scripts/bundle.cjs",
    "lint": "eslint src test scripts",
    "test": "npm run compile && npm run lint && node --test out/test/*.test.js",
    "test:integration": "npm run compile && node scripts/integration.cjs",
    "package": "npm run compile && vsce package --no-dependencies --baseContentUrl https://github.com/ExMikuPro/Sakura-Atelier/blob/dev/ --baseImagesUrl https://github.com/ExMikuPro/Sakura-Atelier/raw/dev/ --out sakura-atelier-0.1.0.vsix && node scripts/verify-package.cjs",
    "test:ui": "npm run compile && playwright test",
    "test:wizard": "npm run compile && node scripts/wizard-integration.cjs",
    "test:projects": "npm run compile && node scripts/projects-integration.cjs",
    "test:stm32-intellisense": "npm run compile && node scripts/stm32-intellisense-integration.cjs",
    "test:platformio": "npm run compile && node scripts/platformio-integration.cjs",
    "test:platformio-intellisense": "npm run compile && node scripts/platformio-intellisense-integration.cjs",
    "test:language-projects": "npm run compile && node scripts/language-projects-integration.cjs",
    "test:language-debug": "npm run compile && node scripts/language-debug-integration.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^18.19.0",
    "@types/vscode": "1.85.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "jsonc-parser": "^3.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ExMikuPro/Sakura-Atelier.git"
  }
}
