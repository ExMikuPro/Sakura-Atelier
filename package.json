    "menus": {
      "editor/title": [
        {
          "command": "sakuraAtelier.run",
          "when": "((resourceScheme == file && editorLangId =~ /^(go|python|rust|c|cpp|csharp|java|javascript|javascriptreact|typescript|typescriptreact)$/) && !sakuraAtelier.uiEnglish) && !sakuraAtelier.stm32Editor && !sakuraAtelier.platformioEditor",
          "group": "navigation@1"
        },
        {
          "command": "sakuraAtelier.debug",
          "when": "((resourceScheme == file && editorLangId =~ /^(go|python|rust|c|cpp|csharp|java|javascript|javascriptreact|typescript|typescriptreact)$/) && !sakuraAtelier.uiEnglish) && !sakuraAtelier.stm32Editor && !sakuraAtelier.platformioEditor",
          "group": "navigation@2"
        },
        {
          "command": "sakuraAtelier.selectConfiguration",
          "when": "((resourceScheme == file && editorLangId =~ /^(go|python|rust|c|cpp|csharp|java|javascript|javascriptreact|typescript|typescriptreact)$/) && !sakuraAtelier.uiEnglish) && !sakuraAtelier.stm32Editor && !sakuraAtelier.platformioEditor",
          "group": "navigation@3"
        },
        {
          "command": "sakuraAtelier.stop",
          "when": "((resourceScheme == file && editorLangId =~ /^(go|python|rust|c|cpp|csharp|java|javascript|javascriptreact|typescript|typescriptreact)$/ && (sakuraAtelier.debugRunning || sakuraAtelier.runRunning)) && !sakuraAtelier.uiEnglish) && !sakuraAtelier.stm32Editor && !sakuraAtelier.platformioEditor",
          "group": "navigation@4"
        },
        {
          "command": "sakuraAtelier.english.run",
          "when": "((resourceScheme == file && editorLangId =~ /^(go|python|rust|c|cpp|csharp|java|javascript|javascriptreact|typescript|typescriptreact)$/) && sakuraAtelier.uiEnglish) && !sakuraAtelier.stm32Editor && !sakuraAtelier.platformioEditor",
          "group": "navigation@1"
        },
        {
          "command": "sakuraAtelier.english.debug",
          "when": "((resourceScheme == file && editorLangId =~ /^(go|python|rust|c|cpp|csharp|java|javascript|javascriptreact|typescript|typescriptreact)$/) && sakuraAtelier.uiEnglish) && !sakuraAtelier.stm32Editor && !sakuraAtelier.platformioEditor",
          "group": "navigation@2"
        },
        {
          "command": "sakuraAtelier.english.selectConfiguration",
          "when": "((resourceScheme == file && editorLangId =~ /^(go|python|rust|c|cpp|csharp|java|javascript|javascriptreact|typescript|typescriptreact)$/) && sakuraAtelier.uiEnglish) && !sakuraAtelier.stm32Editor && !sakuraAtelier.platformioEditor",
          "group": "navigation@3"
        },
        {
          "command": "sakuraAtelier.english.stop",
          "when": "((resourceScheme == file && editorLangId =~ /^(go|python|rust|c|cpp|csharp|java|javascript|javascriptreact|typescript|typescriptreact)$/ && (sakuraAtelier.debugRunning || sakuraAtelier.runRunning)) && sakuraAtelier.uiEnglish) && !sakuraAtelier.stm32Editor && !sakuraAtelier.platformioEditor",
          "group": "navigation@4"
        },
        {
          "command": "sakuraAtelier.embedded.stm32.build",
          "when": "sakuraAtelier.stm32Editor",
          "group": "navigation@1"
        },
        {
          "command": "sakuraAtelier.embedded.stm32.run",
          "when": "sakuraAtelier.stm32Editor",
          "group": "navigation@2"
        },
        {
          "command": "sakuraAtelier.embedded.stm32.debug",
          "when": "sakuraAtelier.stm32Editor",
          "group": "navigation@3"
        },
        {
          "command": "sakuraAtelier.selectConfiguration",
          "when": "sakuraAtelier.stm32Editor && !sakuraAtelier.platformioEditor",
          "group": "navigation@4"
        },
        {
          "command": "sakuraAtelier.stop",
          "when": "sakuraAtelier.stm32Editor && (sakuraAtelier.debugRunning || sakuraAtelier.runRunning) && !sakuraAtelier.platformioEditor",
          "group": "navigation@5"
        },
        {
          "command": "sakuraAtelier.embedded.platformio.build",
          "when": "sakuraAtelier.platformioEditor",
          "group": "navigation@1"
        },
        {
          "command": "sakuraAtelier.embedded.platformio.upload",
          "when": "sakuraAtelier.platformioEditor",
          "group": "navigation@2"
        },
        {
          "command": "sakuraAtelier.embedded.platformio.debug",
          "when": "sakuraAtelier.platformioEditor",
          "group": "navigation@3"
        },
        {
          "command": "sakuraAtelier.embedded.platformio.monitor",
          "when": "sakuraAtelier.platformioEditor",
          "group": "navigation@4"
        },
        {
          "command": "sakuraAtelier.embedded.platformio.selectEnvironment",
          "when": "sakuraAtelier.platformioEditor",
          "group": "navigation@5"
        },
        {
          "command": "sakuraAtelier.selectConfiguration",
          "when": "sakuraAtelier.platformioEditor",
          "group": "navigation@6"
        },
        {
          "command": "sakuraAtelier.stop",
          "when": "sakuraAtelier.platformioEditor && (sakuraAtelier.runRunning || sakuraAtelier.debugRunning)",
          "group": "navigation@7"
        },
        {
          "command": "sakuraAtelier.embedded.platformio.stopMonitor",
          "when": "sakuraAtelier.platformioEditor && sakuraAtelier.monitorRunning",
          "group": "navigation@8"
        },
        {
          "command": "sakuraAtelier.build",
          "when": "sakuraAtelier.languageProjectBuild && !sakuraAtelier.stm32Editor && !sakuraAtelier.platformioEditor",
          "group": "navigation@0"
        }
      ],
